# Put these locations inside the existing example.com server {} block.
# The main site's login middleware at 127.0.0.1:3000 is the public auth boundary.
location = /_garden_auth {
    internal;
    proxy_pass http://127.0.0.1:3000/;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Cookie $http_cookie;
    proxy_intercept_errors on;
    error_page 301 302 303 307 308 = @garden_auth_denied;
}

location @garden_auth_denied {
    internal;
    return 401;
}

location /garden/ {
    auth_request /_garden_auth;
    error_page 401 403 =302 /login;

    proxy_pass http://127.0.0.1:8137/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
