# 和风天气 API（不配置则无真实天气影响，院子仍可正常使用）
QWEATHER_API_KEY=你的和风天气key
QWEATHER_HOST=devapi.qweather.com
QWEATHER_CITY=101010100

# 文案生成 API（不配置则使用本地兜底文案）
# 密钥也可以写入 .garden/api_key 文件（chmod 600）
# GARDEN_API_KEY=你的DeepSeek密钥
GARDEN_API_BASE=https://api.deepseek.com/v1
GARDEN_MODEL=deepseek-v4-pro

# 功能开关
GARDEN_NATURAL_CROP_CONDITIONS_ENABLED=1
GARDEN_REAL_ENVIRONMENT_ENABLED=1

# 存档路径（默认当前目录下 garden.json）
# GARDEN_FILE=./garden.json
